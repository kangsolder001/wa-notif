{
  "openapi": "3.0.3",
  "info": {
    "title": "WhatsApp Notification Service API",
    "description": "Ultra-lightweight WhatsApp notification gateway built with Go, Whatsmeow, and Clean Architecture.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Local server"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Bearer token configured in config.json"
      }
    },
    "schemas": {
      "SendMessageRequest": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "to": {
            "type": "string",
            "description": "Recipient phone number (e.g. '08123456789' or '628123456789'). If omitted, uses default_recipient from config.",
            "example": "081234567890"
          },
          "message": {
            "type": "string",
            "description": "Message content supporting WhatsApp formatting (*bold*, _italic_, etc.)",
            "example": "*[ALERT]* Backup database completed successfully at 07:00."
          }
        }
      },
      "SendMediaRequest": {
        "type": "object",
        "properties": {
          "to": {
            "type": "string",
            "description": "Recipient phone number",
            "example": "081234567890"
          },
          "caption": {
            "type": "string",
            "description": "Caption for the image/document",
            "example": "Grafik Server CPU Spike"
          },
          "type": {
            "type": "string",
            "enum": ["image", "document"],
            "description": "Type of media to send",
            "example": "image"
          },
          "file_name": {
            "type": "string",
            "description": "File name for document attachment",
            "example": "backup_report.pdf"
          },
          "mime_type": {
            "type": "string",
            "description": "MIME type (optional, auto-detected if empty)",
            "example": "image/png"
          },
          "media_url": {
            "type": "string",
            "description": "Public or local HTTP URL to download media from",
            "example": "http://192.168.1.10:8000/snapshot.jpg"
          },
          "data_base64": {
            "type": "string",
            "description": "Base64 encoded binary data",
            "example": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII="
          }
        }
      },
      "APIResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": { "type": "object" },
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/api/v1/messages/send": {
      "post": {
        "summary": "Send Text Message",
        "description": "Sends a text notification to a recipient or the default recipient.",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SendMessageRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Message sent successfully" },
          "400": { "description": "Invalid input format" },
          "401": { "description": "Unauthorized (missing or invalid Bearer token)" },
          "503": { "description": "WhatsApp not connected" }
        }
      }
    },
    "/api/v1/messages/send-media": {
      "post": {
        "summary": "Send Media / Document Message",
        "description": "Sends an image or document attachment via URL or Base64.",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SendMediaRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Media sent successfully" },
          "400": { "description": "Invalid input format" },
          "401": { "description": "Unauthorized" },
          "503": { "description": "WhatsApp not connected" }
        }
      }
    },
    "/api/v1/session/status": {
      "get": {
        "summary": "Get Session & Connection Status",
        "description": "Returns current WhatsApp connection state and device JID.",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Connection status returned" }
        }
      }
    },
    "/api/v1/session/qr": {
      "get": {
        "summary": "Get Pairing QR Code",
        "description": "Returns raw QR code string and base64 PNG data URL for scanning.",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "QR code payload" }
        }
      }
    },
    "/api/v1/session/logout": {
      "post": {
        "summary": "Logout / Unlink Device",
        "description": "Unlinks current WhatsApp device session.",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Logged out successfully" }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health Check",
        "description": "Service liveness probe endpoint (no authentication required).",
        "responses": {
          "200": { "description": "Service is healthy" }
        }
      }
    }
  }
}
